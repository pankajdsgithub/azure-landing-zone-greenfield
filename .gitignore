# Terraform local working directories
**/.terraform/*

# Terraform state and saved plans
*.tfstate
*.tfstate.*
*.tfplan
.terraform.tfstate.lock.info

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Python virtual environment
.venv-checkov/

# Local backend configuration
terraform/bootstrap/state-backend/backend.hcl
terraform/environments/platform/backend.hcl
terraform/environments/governance/backend.hcl

# Local Azurite artifacts
__azurite_db_*.json
__blobstorage__/
__queuestorage__/
__tablestorage__/

# Local review backups and generated Python files
__pycache__/
*.py[cod]
*.backup
*.step2-backup
*.pre-*
*.cleanup-backup
